PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?iri (COALESCE(MIN(STR(?name)), STRAFTER(STR(?iri), "#")) AS ?label) WHERE {
  VALUES ?class { __CLASSES__ }
  ?iri rdf:type/rdfs:subClassOf* ?class .
  FILTER(isIRI(?iri) && STRSTARTS(STR(?iri), "http://uow.edu.au/isit906/thestar/digitalcare#"))
  OPTIONAL { ?iri rdfs:label ?name }
} GROUP BY ?iri ORDER BY LCASE(?label)
