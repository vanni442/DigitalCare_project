dc:caresForSomeoneWith
        rdf:type                owl:ObjectProperty;
        rdfs:comment            "Shortcut from a Carer to the health condition of the person they care for. Entailed by caresFor o hasCondition; never asserted directly.";
        rdfs:domain             dc:Carer;
        rdfs:label              "caresForSomeoneWith";
        rdfs:range              dc:HealthCondition;
        ns1:axiomCQ             "CQ1, CQ2";
        ns1:character           "none";
        ns1:readAloud           "a Carer caresForSomeoneWith a HealthCondition";
        ns1:usedByCQ            "CQ1, CQ2";
        owl:propertyChainAxiom  ( dc:caresFor dc:hasCondition ) .

