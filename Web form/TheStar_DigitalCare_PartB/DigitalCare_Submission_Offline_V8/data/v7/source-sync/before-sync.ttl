        ns1:sourceCell    "2. Classes!A11:F11";
        ns1:usedByCQ      "CQ1, CQ2, CQ3, CQ5, CQ6, CQ7";
        ns1:worksheetRow  "2. Classes!A11:F11 | A=HealthCondition | B=Specifying the health condition(s) of a patient, medical study, or other target audience. | C=InformationTopic | D=CQ1, CQ2, CQ3, CQ5, CQ6, CQ7 | E=https://schema.org/MedicalCondition | F=Provides a recognised medical meaning for symptoms.";
