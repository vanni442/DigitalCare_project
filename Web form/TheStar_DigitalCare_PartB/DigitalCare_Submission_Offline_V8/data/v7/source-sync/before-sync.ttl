PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>

[ rdf:type             owl:AllDifferent;
  owl:distinctMembers  ( dc:BathingDifficulty dc:Confusion dc:DressingDifficulty dc:EatingDifficulty dc:MemoryLoss dc:VisualHallucination )
] .

dc:InformationTopic  rdf:type  owl:Class;
