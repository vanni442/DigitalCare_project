    <!-- http://uow.edu.au/isit906/thestar/digitalcare#CarerGuide -->

    <owl:Class rdf:about="http://uow.edu.au/isit906/thestar/digitalcare#CarerGuide">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://uow.edu.au/isit906/thestar/digitalcare#Guide"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://uow.edu.au/isit906/thestar/digitalcare#isIntendedFor"/>
                        <owl:someValuesFrom rdf:resource="http://uow.edu.au/isit906/thestar/digitalcare#Carer"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <worksheet:axiomCQ>CQ1, CQ4</worksheet:axiomCQ>
        <rdfs:comment>A Guide whose intended audience includes a Carer. Defined class: membership is entailed from isIntendedFor, never asserted.</rdfs:comment>
        <rdfs:label>CarerGuide</rdfs:label>
    </owl:Class>
    


