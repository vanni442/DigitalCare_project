    <!-- http://uow.edu.au/isit906/thestar/digitalcare#caresForSomeoneWith -->

    <owl:ObjectProperty rdf:about="http://uow.edu.au/isit906/thestar/digitalcare#caresForSomeoneWith">
        <rdfs:domain rdf:resource="http://uow.edu.au/isit906/thestar/digitalcare#Carer"/>
        <rdfs:range rdf:resource="http://uow.edu.au/isit906/thestar/digitalcare#HealthCondition"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://uow.edu.au/isit906/thestar/digitalcare#caresFor"/>
            <rdf:Description rdf:about="http://uow.edu.au/isit906/thestar/digitalcare#hasCondition"/>
        </owl:propertyChainAxiom>
        <worksheet:axiomCQ>CQ1, CQ2</worksheet:axiomCQ>
        <worksheet:character>none</worksheet:character>
        <worksheet:readAloud>a Carer caresForSomeoneWith a HealthCondition</worksheet:readAloud>
        <worksheet:usedByCQ>CQ1, CQ2</worksheet:usedByCQ>
        <rdfs:comment>Shortcut from a Carer to the health condition of the person they care for. Entailed by caresFor o hasCondition; never asserted directly.</rdfs:comment>
        <rdfs:label>caresForSomeoneWith</rdfs:label>
    </owl:ObjectProperty>
    


